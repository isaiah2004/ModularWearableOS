CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# XMC 16MB flash supports quad I/O: QIO doubles code/rodata fetch bandwidth vs DIO.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# Rated CPU speed gives the software AA renderer enough headroom for 60 Hz.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# DFS only: UI/prewarm locks retain 240MHz; blocked idle can use 80MHz.
CONFIG_PM_ENABLE=y
# CONFIG_PM_DFS_INIT_AUTO is not set
# Every dirty-rect stripe re-runs the app's draw list + rasterizers + icon code; with a
# 16KB I-cache that path thrashed (app-list raster 9.6 -> 6.1 ms at 32KB). Costs ~16KB
# of internal heap (57.8 -> 41.3 KB free at boot).
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
# Candidate for measured PSRAM streaming: same 32 KiB cache, wider fetch lines.
# Does not consume the extra 32 KiB SRAM required by a 64 KiB data cache.
CONFIG_ESP32S3_DATA_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
# 15MB app partition (baked Earth sprite + fonts need more than the 1MB default)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# ESP32-S3R8: 8MB octal PSRAM — holds the 466x466 framebuffer
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# 1kHz scheduler tick -> finer task timing, snappier touch/UI loop
CONFIG_FREERTOS_HZ=1000
# Raw IMU recorder workers use explicitly allocated PSRAM stacks.
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
CONFIG_FREERTOS_SUPPORT_STATIC_ALLOCATION=y
# Bluetooth: NimBLE host only (passive observer). Bluedroid is deselected by
# choosing NimBLE, keeping RAM/flash down.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# Wi-Fi + BLE share the radio -> enable software coexistence so a Wi-Fi scan
# and the background BLE discovery don't fight over the antenna.
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
# Keep Wi-Fi buffer pools small to
# reclaim internal RAM — the display's DMA stripe buffers + BT need it. Boot with
# defaults left only ~28KB internal free (crash-prone); this restores headroom.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
# NimBLE scanner + one companion connection.
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2
# Offload Wi-Fi/LWIP buffers and the NimBLE host into PSRAM (8MB) to free the
# scarce internal DMA RAM for the display and BT controller.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=128
CONFIG_FATFS_FS_LOCK=8
# TLS record buffers belong in PSRAM; reserve internal memory for display DMA.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
# OTA: an image that never confirms itself (ota_mark_valid) rolls back on reset.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# GitHub release downloads redirect across hosts.
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y
# Internal SRAM is the scarce pool (display DMA stripes, I2S DMA, TLS AES): keep Wi-Fi's
# static TX buffers and IRAM-optimised paths out of it, and let >4 KB mallocs use PSRAM.
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=6
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
# CONFIG_ESP_COREDUMP_ENABLE_TO_NONE is not set
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_COREDUMP_FLASH_NO_OVERWRITE=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=16
CONFIG_ESP_COREDUMP_STACK_SIZE=1792
# CONFIG_ESP_COREDUMP_LOGS is not set
# CONFIG_ESP_COREDUMP_CAPTURE_DRAM is not set
CONFIG_APP_RETRIEVE_LEN_ELF_SHA=64
# Automatic light sleep while the display is not ON (see docs/LIGHT_SLEEP.md).
# Tickless idle lets FreeRTOS enter light sleep from the idle task; nos_power.c holds
# an ESP_PM_NO_LIGHT_SLEEP lock whenever the display is ON or USB is connected.
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_PM_LIGHT_SLEEP_CALLBACKS=y
# USB-Serial-JTAG cannot run in light sleep: the IDF holds a NO_LIGHT_SLEEP lock while a host is connected.
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y
# NimBLE controller: modem sleep clocked from the main XTAL (kept powered in light sleep) keeps links alive.
CONFIG_BT_CTRL_MODEM_SLEEP=y
CONFIG_BT_CTRL_MODEM_SLEEP_MODE_1=y
CONFIG_BT_CTRL_LPCLK_SEL_MAIN_XTAL=y
CONFIG_BT_CTRL_MAIN_XTAL_PU_DURING_LIGHT_SLEEP=y
# Wakes happen ~20x/s: calibrate the RTC clocks every 64 sleeps (~3 s) instead of every sleep.
CONFIG_PM_LIGHTSLEEP_RTC_OSC_CAL_INTERVAL=64
