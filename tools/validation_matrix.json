    {
      "name": "weather_parse",
      "sources": [
        "tests/weather_parse_test.c",
        "firmware/main/weather_parse.c",
        "{cjson}/cJSON.c"
      ],
      "flags": [
        "-I{cjson}"
      ],
      "runs": [
        [
          "{root}/tests/fixtures/weather.json"
        ]
      ]
    }
  ],
  "simulator_groups": [
    "tools/test_sim_script_io.py",
    "tools/test_workout_sim.py --no-media"
  ],
  "hardware_profile": {
    "tool": "tools/check_connectivity_device.py",
    "required": [
      "--port",
      "--expected-elf-sha256",
      "--run-hardware"
    ],
    "default": "dry-run only; no serial imports or mutations"
  },
  "budgets": {
    "flash_bytes": 16777216,
    "psram_bytes": 8388608,
    "application_limit": "actual app partition from flashed partition-table.bin",
    "headroom": "actual app partition bytes minus exact image bytes; over-limit fails"
  },
  "legacy": "sim/build.ps1 is archived core/apps; optional legacy coverage remains available through tools/test.ps1.",
  "offline_dependencies": {
    "cjson": "ESP-IDF components/json/cJSON, or --cjson-dir; CI pins DaveGamble/cJSON v1.7.19; both source/header hashes are included in reports."
  }
}
