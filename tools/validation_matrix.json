{
  "schema": 1,
  "entrypoint": "python tools/validate.py",
  "python": "3.12.8",
  "ci_host_gcc": "12.2.0",
  "host_tests": [
    "tests/test_host_transport.py",
    "tests/test_watchctl.py",
    "tests/test_sdsync.py",
    "tests/test_host_sd_contract.py",
    "tests/test_flash_watch.py",
